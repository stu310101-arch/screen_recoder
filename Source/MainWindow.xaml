<Window x:Class="Aureo.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Amos錄影與截圖" Icon="aureo.ico" Width="940" Height="800" MinWidth="880" MinHeight="740" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip">
 <Border BorderBrush="#39352C" BorderThickness="1">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Background="#101216" MouseLeftButtonDown="TitleDrag">
    <StackPanel Orientation="Horizontal" Margin="26,0" VerticalAlignment="Center"><Image Source="aureo.ico" Width="26" Height="26"/><TextBlock Text="  Amos錄影與截圖" Foreground="#E5CF9F" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="?" Click="HelpClick" Background="Transparent" BorderThickness="0" Width="44" Padding="0"/><Button Content="─" Click="MinimizeClick" BorderThickness="0" Background="Transparent" Width="44" Padding="0"/><Button Content="□" Click="MaximizeClick" BorderThickness="0" Background="Transparent" Width="44" Padding="0"/><Button Content="✕" Click="CloseClick" BorderThickness="0" Background="Transparent" Width="48" Padding="0"/></StackPanel>
   </Grid>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition x:Name="MicColumn" Width="0"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#111418" BorderBrush="#242830" BorderThickness="0,0,1,0"><StackPanel Margin="8,22,8,0"><Button x:Name="MicSidebarButton" Click="MicSidebarClick" ToolTip="麥克風控制" Padding="0" Height="40" Background="#242118" BorderBrush="#5C4E34"><TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource Gold}"/></Button><TextBlock Text="麥克風" FontSize="9" Foreground="#8F897E" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border>
    <Border x:Name="MicPanel" Grid.Column="1" Visibility="Collapsed" Background="#14171C" BorderBrush="#2B2F36" BorderThickness="0,0,1,0">
     <StackPanel Margin="20,25,20,0">
      <Grid Margin="0,0,0,26"><TextBlock Text="麥克風" FontSize="18" FontWeight="SemiBold"/><Button Content="×" Click="MicSidebarClick" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="5,0" ToolTip="收合側欄"/></Grid>
      <CheckBox x:Name="MicCheck" Content="錄製我的聲音" Checked="MicSettingsChanged" Unchecked="MicSettingsChanged" FontSize="14"/>
      <TextBlock Text="輸入裝置" Foreground="#818995" FontSize="11" Margin="0,24,0,8"/>
      <ComboBox x:Name="MicDeviceCombo" DisplayMemberPath="Label" SelectionChanged="MicDeviceChanged"/>
      <Grid Margin="0,26,0,12"><TextBlock Text="錄製音量" Foreground="#BEC2CA" FontSize="12"/><TextBlock x:Name="MicVolumeLabel" Text="100%" Foreground="{StaticResource Gold}" HorizontalAlignment="Right" FontSize="12"/></Grid>
      <Slider x:Name="MicVolumeSlider" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="MicVolumeChanged" ToolTip="只調整錄影中的人聲音量，不更改 Windows 麥克風音量" IsMoveToPointEnabled="True">
       <Slider.Template><ControlTemplate TargetType="Slider"><Grid Height="22"><Track x:Name="PART_Track">
        <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" Background="#D5B77C" CornerRadius="1"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" Background="#333842" CornerRadius="1"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
        <Track.Thumb><Thumb Width="13" Height="13"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#D5B77C" CornerRadius="7" BorderBrush="#EDD5A7" BorderThickness="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
       </Track></Grid></ControlTemplate></Slider.Template>
      </Slider>
      <TextBlock Text="即時音量" Foreground="#818995" FontSize="11" Margin="0,28,0,12"/>
      <ProgressBar x:Name="MicMeter" Minimum="0" Maximum="100" Height="7" Background="#292E37" Foreground="{StaticResource Gold}"><ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Border Background="{TemplateBinding Background}" CornerRadius="3"><Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="3"/></Grid></Border></ControlTemplate></ProgressBar.Template></ProgressBar>
      <TextBlock x:Name="MicMeterLabel" Text="麥克風未錄製" Foreground="#8B929E" FontSize="11" Margin="0,12,0,0"/>
      <Border BorderBrush="#2D323B" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,28,0,0"><TextBlock Text="錄製中也能開關人聲、調整音量。暫停時的設定會在繼續錄製後生效。" Foreground="#7D8592" FontSize="11" LineHeight="20"/></Border>
     </StackPanel>
    </Border>
   <Grid Grid.Column="2" Margin="28,22,28,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,22"><TextBlock Text="錄影與截圖" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="ReadyLabel" Text="●  準備就緒" Foreground="#BEB29A" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    <Border Grid.Row="1" Background="#171A1F" CornerRadius="9" Padding="4" Margin="0,0,0,16">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Button x:Name="ScreenMode" Content="▣   螢幕" Tag="Screen" Click="ModeClick" Padding="10,12" BorderThickness="0" Margin="0,0,3,0"/>
      <Button x:Name="RegionMode" Grid.Column="1" Content="⌗   範圍" Tag="Region" Click="ModeClick" Padding="10,12" BorderThickness="0" Margin="3,0"/>
      <Button x:Name="WindowMode" Grid.Column="2" Content="▱   視窗" Tag="Window" Click="ModeClick" Padding="10,12" BorderThickness="0" Margin="3,0,0,0"/>
     </Grid>
    </Border>
    <Grid Grid.Row="2" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ComboBox x:Name="SourceCombo" SelectionChanged="SourceChanged" DisplayMemberPath="Label"/>
     <Button Grid.Column="1" Content="↻" Click="RefreshClick" Width="40" Margin="8,0,0,0" Padding="0" ToolTip="重新整理來源"/>
     <Button x:Name="SelectRegionButton" Grid.Column="2" Content="框選範圍" Click="SelectRegionClick" Visibility="Collapsed" Margin="8,0,0,0" Padding="14,8" Style="{StaticResource GoldButton}"/>
    </Grid>
    <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="#080A0D" CornerRadius="9" BorderBrush="#292C32" BorderThickness="1" ClipToBounds="True">
      <Grid><Image x:Name="Preview" Stretch="Uniform" Opacity="0.9"/><StackPanel x:Name="PreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="▣" FontSize="30" Foreground="#877653" HorizontalAlignment="Center"/><TextBlock Text="選擇錄製來源" Foreground="#777D87" FontSize="12" Margin="0,12,0,0"/></StackPanel><Border Background="#D90D0F12" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="4" Padding="8,5" Margin="10"><TextBlock x:Name="PreviewBadge" Text="預覽" Foreground="#CDB888" FontSize="9"/></Border></Grid>
     </Border>
     <Grid Grid.Row="1" Margin="0,9,0,0"><TextBlock x:Name="SourceInfo" Foreground="#838994" FontSize="10" MaxWidth="640" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="MP4 / PNG" Foreground="#6A717B" FontSize="10" HorizontalAlignment="Right"/></Grid>
    </Grid>
    <StackPanel Grid.Row="4" Margin="0,20,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
     <CheckBox x:Name="SystemCheck" Content="系統音訊" IsChecked="True" Checked="SystemAudioChanged" Unchecked="SystemAudioChanged" Margin="0" VerticalAlignment="Center"/>
     <ComboBox x:Name="FpsCombo" Grid.Column="1" SelectedIndex="1" SelectionChanged="VideoSettingsChanged"><ComboBoxItem Content="30 FPS"/><ComboBoxItem Content="60 FPS"/><ComboBoxItem Content="120 FPS"/></ComboBox>
     <ComboBox x:Name="ResolutionCombo" Grid.Column="3" SelectedIndex="0" SelectionChanged="VideoSettingsChanged" ToolTip="固定解析度為 16:9，不同比例補黑邊。來源低於選定解析度時會放大輸出。"><ComboBoxItem Content="原始解析度"/><ComboBoxItem Content="720p"/><ComboBoxItem Content="1080p"/><ComboBoxItem Content="1440p"/><ComboBoxItem Content="2160p · 4K"/></ComboBox>
     <ComboBox x:Name="QualityCombo" Grid.Column="5" SelectedIndex="1" SelectionChanged="VideoSettingsChanged"><ComboBoxItem Content="精省"/><ComboBoxItem Content="高畫質"/><ComboBoxItem Content="極致"/></ComboBox>
    </Grid><TextBlock x:Name="EncodingHint" Foreground="#7E8794" FontSize="10" Margin="0,9,0,0"/></StackPanel>
    <StackPanel Grid.Row="5" Margin="0,16,0,0">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="影片" Foreground="#9A9FA8" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <Border Grid.Column="1" Background="#171A1F" BorderBrush="#30343B" BorderThickness="1" CornerRadius="6" Padding="12,9"><TextBlock x:Name="FolderLabel" Foreground="#B8BDC5" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></Border>
      <Button x:Name="SaveFolderButton" Grid.Column="2" Content="選擇資料夾" Click="ChangeFolderClick" Foreground="{StaticResource Gold}" Margin="8,0,0,0" Padding="13,8"/>
      <Button Grid.Column="3" Content="↗" Click="FolderClick" Width="36" Margin="8,0,0,0" Padding="0" ToolTip="開啟儲存資料夾"/>
     </Grid>
     <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="圖片" Foreground="#9A9FA8" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <Border Grid.Column="1" Background="#171A1F" BorderBrush="#30343B" BorderThickness="1" CornerRadius="6" Padding="12,9"><TextBlock x:Name="PictureFolderLabel" Foreground="#B8BDC5" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></Border>
      <Button x:Name="PictureFolderButton" Grid.Column="2" Content="選擇資料夾" Click="ChangePictureFolderClick" Foreground="{StaticResource Gold}" Margin="8,0,0,0" Padding="13,8"/>
      <Button Grid.Column="3" Content="↗" Click="PictureFolderClick" Width="36" Margin="8,0,0,0" Padding="0" ToolTip="開啟圖片資料夾"/>
     </Grid>
    <Expander x:Name="AdvancedSettings" Header="進階設定" Foreground="#8C929C" FontSize="11" Margin="0,10,0,0">
     <Border Background="#15181D" CornerRadius="8" Padding="14" Margin="0,10,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="ApiCombo" SelectedIndex="0" Width="290" HorizontalAlignment="Left"><ComboBoxItem Content="Desktop Duplication · 遊戲建議"/><ComboBoxItem Content="Windows Graphics Capture"/></ComboBox>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><CheckBox x:Name="CursorCheck" Content="游標" IsChecked="True" Margin="18,0,0,0"/><CheckBox x:Name="CountdownCheck" Content="倒數 3 秒" IsChecked="True" Margin="18,0,0,0"/></StackPanel>
     </Grid></Border>
    </Expander>
    </StackPanel>
    <Border Grid.Row="6" BorderBrush="#272A30" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,18,0,0">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock x:Name="StatusText" Text="切換應用程式，畫面也會跟著錄下。" Foreground="#A5AAB3" FontSize="11"/><TextBlock Text="Ctrl + Shift + F9  暫停  ·  Ctrl + Shift + F10  停止" Foreground="#606873" FontSize="10" Margin="0,7,0,0"/></StackPanel><Button x:Name="StartButton" Grid.Column="1" Content="開始使用" Click="StartClick" Style="{StaticResource GoldButton}" Width="180" Height="48" FontSize="15"/></Grid>
    </Border>
   </Grid>
   </Grid>
  </Grid>
 </Border>
</Window>
